# Copy this file to `.env.local` for local development.
# `.env.local` and every other `.env*` file except this one are git-ignored.
# NEVER put real credentials in this file or commit them anywhere.
#
# Naming rule: only variables prefixed NEXT_PUBLIC_ are sent to the browser.
# A NEXT_PUBLIC_ variable must never hold a secret (`npm run hygiene` enforces this).

# ---------------------------------------------------------------------------
# Used now (server only)
# ---------------------------------------------------------------------------
# development | test | preview | production
APP_ENV=development
# Public origin of this deployment (used for metadata and, later, CSRF Origin checks)
APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Used by the authentication API (Patch B9) and the route guards / sign-in pages (Patch B11) — server only,
# read lazily at request time. `next build` and /api/health do not need them; signing in and every protected page do.
# (The Playwright suite generates its own throwaway values and a stand-in database; it never reads these.)
# ---------------------------------------------------------------------------
# Supabase project URL (public by design) and the SERVICE-ROLE key (SECRET: full database access, server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for hashing session tokens. SECRET. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it logs everybody out.
SESSION_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Used by the scheduled sweep (Patch B15, GET /api/cron/expire-teams) — server only, optional
# ---------------------------------------------------------------------------
# Shared secret that Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`. SECRET. At least 32 random characters,
# e.g. `openssl rand -base64 48`. Set it in the Vercel project settings, never in a file. When it is missing the route
# refuses every request (401); the game stays correct because finalization is also done lazily on every participant read.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Reserved for later patches — leave empty until then
# ---------------------------------------------------------------------------
# Public (browser-visible; safe by design, grants no table access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — SECRET
SUPABASE_JWT_SECRET=

# Demo / development identities (an ADMIN and test teams) are likewise never configured here. Create them with
#   PROVISION_DATABASE_URL=postgres://owner@127.0.0.1:5432/db npm run provision:demo -- --teams 2 --open-competition
# after the Super Admin exists. Passwords are random and printed once. See docs/AUTH_UI.md. Never run it in production.
#
# The Super Admin account is NOT configured here. It is created once, interactively, with
#   PROVISION_DATABASE_URL=postgres://owner@host:5432/db npm run provision:superadmin
# (set in your shell for that one command only; never put it in a file). The username and password are typed at the prompt.
